<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.chat.ChatFragment">

    <!-- ========= 上部の操作エリア ========= -->

    <!-- 会話要約ボタン -->
    <Button
        android:id="@+id/buttonAnalyze"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="会話を要約"
        android:layout_marginStart="8dp"

        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonAnalyzeRace"/>

    <!-- レース結果分析ボタン -->
    <Button
        android:id="@+id/buttonAnalyzeRace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="レース結果を分析"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/buttonAnalyze"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 競馬場選択のタイトル -->
    <TextView
        android:id="@+id/textViewVenueSelectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="分析したい競馬場を選択してください："
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/buttonAnalyze"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ▼▼▼【ここから修正】CheckBoxをRadioButtonに変更し、RadioGroupで囲む ▼▼▼ -->
    <HorizontalScrollView
        android:id="@+id/venue_checkbox_scroller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/textViewVenueSelectionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- RadioGroupが単一選択を管理します -->
        <RadioGroup
            android:id="@+id/venue_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- CheckBox を RadioButton に変更 -->
            <!-- IDはJavaコードで使うのでそのまま -->
            <RadioButton
                android:id="@+id/checkbox_chukyo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中京" />
            <RadioButton
                android:id="@+id/checkbox_tokyo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="札幌" />
            <RadioButton
                android:id="@+id/checkbox_kyoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="新潟" />
            <RadioButton
                android:id="@+id/checkbox_hanshin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="阪神" />
            <RadioButton
                android:id="@+id/checkbox_nakayama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中山" />
            <!-- 他の競馬場も同様にRadioButtonとして追加 -->

        </RadioGroup>
    </HorizontalScrollView>
    <!-- ▲▲▲【ここまで修正】▲▲▲ -->


    <!-- ========= チャット表示エリア ========= -->


    <!-- ========= メッセージ入力エリア (変更なし) ========= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/venue_checkbox_scroller"
        app:layout_constraintVertical_bias="0.0" />

    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/editTextMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="メッセージを入力..."
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/buttonSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="送信"
            android:src="@android:drawable/ic_menu_send" />

        <View
            android:id="@+id/viewInputDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/darker_gray" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>