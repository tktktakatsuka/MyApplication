<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.tktkcompany.kakoRaceKeiba.ui.home.HomeFragment"
        android="@color/tyairo"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_navigation_home_to_navigation_raceResults"
            app:destination="@id/navigation_raceResults" />
        <action
            android:id="@+id/action_navigation_home_to_navigation_favorites"
            app:destination="@id/navigation_favorites" />
        <action
            android:id="@+id/action_navigation_home_to_navigation_entries"
            app:destination="@id/navigation_entries" />
    </fragment>


    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.tktkcompany.kakoRaceKeiba.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        android:textColor="@color/tyairo"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_fragmentB_to_fragmentC"
            app:destination="@+id/navigation_raceResults" />
    </fragment>

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.tktkcompany.kakoRaceKeiba.ui.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_raceResults"
        android:name="com.tktkcompany.kakoRaceKeiba.ui.raceResult.RaceResultsFragment"
        android:label="レース結果"
        android:textColor="@color/tyairo"
        tools:layout="@layout/fragment_raceresults" />

    <fragment
        android:id="@+id/navigation_horseMemos"
        android:name="com.tktkcompany.kakoRaceKeiba.ui.horsememo.HorseMemoListFragment"
        android:label="メモ・予想"
        tools:layout="@layout/fragment_horse_memos" />

    <fragment
        android:id="@+id/navigation_favorites"
        android:name="com.tktkcompany.kakoRaceKeiba.ui.favorite.FavoriteHorsesFragment"
        android:label="お気に入り馬"
        tools:layout="@layout/fragment_favorite_horses" />


    <fragment
        android:id="@+id/navigation_predictions"
        android:name="com.tktkcompany.kakoRaceKeiba.ui.prediction.PredictionsFragment"
        android:label="予想・買い目の答え合わせ"
        tools:layout="@layout/fragment_entries" />

    <fragment
        android:id="@+id/navigation_entries"
        android:name="com.tktkcompany.kakoRaceKeiba.ui.entries.EntriesFragment"
        android:label="出走表"
        tools:layout="@layout/fragment_entries">
        <action
            android:id="@+id/action_navigation_entries_to_navigation_entryDetail"
            app:destination="@id/navigation_entryDetail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_entryDetail"
        android:name="com.tktkcompany.kakoRaceKeiba.ui.entries.EntryDetailFragment"
        android:label="出走馬の近走成績"
        tools:layout="@layout/fragment_entries" />

</navigation>
